# ---------------------------------------------------------------------------
# Aden Bungalov — Ortam Değişkenleri (örnek)
# Bu dosya git'e girer; GERÇEK DEĞER İÇERMEZ. Kopyalayıp `.env` oluşturun.
# `.env` git tarafından yok sayılır (.gitignore). Secret'lar YALNIZ burada.
# ---------------------------------------------------------------------------

# Veritabanı (MySQL 8) — Hostinger'da ortam değişkeni olarak ayarlayın.
# Özel karakterli parolaları URL-encode edin (& → %26, @ → %40, # → %23).
# Hostinger örnek: mysql://USER:PASS@srvXXXX.hstgr.io:3306/DB_NAME
DATABASE_URL="mysql://root:DB_PAROLA@HOST:3306/VERITABANI"

# Oturum/token imzalama anahtarı.
# Üretmek için: openssl rand -base64 48
AUTH_SECRET=""

# Uygulama URL'i (canonical origin)
NEXT_PUBLIC_SITE_URL="https://www.adenbungalov.com"

# Seed ile kurulacak ilk SUPERADMIN e-postası
SUPERADMIN_EMAIL="info@aorkuneren.com"

# Medya yükleme klasörü (yerel disk). Üretimde kalıcı ve yazılabilir olmalı.
UPLOAD_DIR="./public/uploads"

# Cron uçlarını korumak için gizli anahtar (POST /api/cron/jobs)
# Üretmek için: openssl rand -hex 32
CRON_SECRET=""

# SMTP (davet ve parola sıfırlama e-postaları)
# Parola BURADA tutulur; settings tablosunda DEĞİL.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="true"

# ---------------------------------------------------------------------------
# İleride (varsayılan kapalı modüller) — gerektiğinde doldurulacak:
# IYZICO_API_KEY / IYZICO_SECRET_KEY / PAYTR_MERCHANT_ID ...
# ---------------------------------------------------------------------------
