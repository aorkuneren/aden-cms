generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Kaynak gerçeği: her CMS dosyası tam JSON fidelity ile saklanır.
model CmsDocument {
  key       String   @id @db.VarChar(191)
  payload   Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cms_documents")
}

model AdminUser {
  id           String   @id @db.VarChar(64)
  email        String   @unique @db.VarChar(255)
  name         String   @db.VarChar(255)
  role         String   @db.VarChar(32)
  passwordHash String   @db.VarChar(255) @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model AuditLog {
  id          String   @id @db.VarChar(64)
  createdAt   DateTime @map("created_at")
  actorUserId String?  @map("actor_user_id") @db.VarChar(64)
  actorName   String?  @map("actor_name") @db.VarChar(255)
  action      String   @db.VarChar(128)
  entityType  String?  @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(128)
  details     Json?

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Inquiry {
  id        String    @id @db.VarChar(64)
  createdAt DateTime  @map("created_at")
  updatedAt DateTime  @map("updated_at")
  type      String    @db.VarChar(32)
  name      String    @db.VarChar(255)
  email     String?   @db.VarChar(255)
  phone     String?   @db.VarChar(64)
  subject   String?   @db.VarChar(512)
  message   String    @db.Text
  status    String    @db.VarChar(32)
  isRead    Boolean   @default(false) @map("is_read")
  ip        String?   @db.VarChar(64)
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.VarChar(64)
  payload   Json?

  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("inquiries")
}

model Bungalov {
  id             String    @id @db.VarChar(64)
  name           String    @db.VarChar(255)
  slug           String?   @unique @db.VarChar(255)
  image          String?   @db.VarChar(1024)
  capacity       Int?
  description    String?   @db.Text
  nightlyPrice   Decimal?  @map("nightly_price") @db.Decimal(12, 2)
  status         String    @default("AKTIF") @db.VarChar(32)
  bedrooms       Int?
  areaSqm        Float?    @map("area_sqm")
  poolType       String?   @map("pool_type") @db.VarChar(64)
  internet       String?   @db.VarChar(128)
  address        String?   @db.Text
  seoTitle       String?   @map("seo_title") @db.VarChar(512)
  seoDescription String?   @map("seo_description") @db.Text
  isFeatured     Boolean   @default(false) @map("is_featured")
  sortOrder      Int       @default(0) @map("sort_order")
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by") @db.VarChar(64)
  createdAt      DateTime? @map("created_at")
  updatedAt      DateTime? @map("updated_at")
  /// Orijinal kayıtta kalan ek alanlar (geriye uyumluluk)
  extra          Json?

  images  BungalovImage[]
  features BungalovFeature[]
  rules   BungalovRule[]
  nearby  BungalovNearby[]

  @@index([status, sortOrder])
  @@index([deletedAt])
  @@map("bungalovs")
}

model BungalovImage {
  id         String  @id @default(cuid()) @db.VarChar(64)
  bungalovId String  @map("bungalov_id") @db.VarChar(64)
  url        String  @db.VarChar(1024)
  sortOrder  Int     @default(0) @map("sort_order")
  bungalov   Bungalov @relation(fields: [bungalovId], references: [id], onDelete: Cascade)

  @@index([bungalovId, sortOrder])
  @@map("bungalov_images")
}

model BungalovFeature {
  id         String  @id @default(cuid()) @db.VarChar(64)
  bungalovId String  @map("bungalov_id") @db.VarChar(64)
  label      String  @db.VarChar(255)
  sortOrder  Int     @default(0) @map("sort_order")
  bungalov   Bungalov @relation(fields: [bungalovId], references: [id], onDelete: Cascade)

  @@index([bungalovId])
  @@map("bungalov_features")
}

model BungalovRule {
  id          String  @id @db.VarChar(64)
  bungalovId  String  @map("bungalov_id") @db.VarChar(64)
  title       String  @db.VarChar(255)
  description String? @db.Text
  visible     Boolean @default(true)
  sortOrder   Int     @default(0) @map("sort_order")
  bungalov    Bungalov @relation(fields: [bungalovId], references: [id], onDelete: Cascade)

  @@index([bungalovId])
  @@map("bungalov_rules")
}

model BungalovNearby {
  id         String  @id @db.VarChar(64)
  bungalovId String  @map("bungalov_id") @db.VarChar(64)
  title      String  @db.VarChar(255)
  distance   String? @db.VarChar(64)
  sortOrder  Int     @default(0) @map("sort_order")
  extra      Json?
  bungalov   Bungalov @relation(fields: [bungalovId], references: [id], onDelete: Cascade)

  @@index([bungalovId])
  @@map("bungalov_nearby")
}

model SeoMeta {
  id              String   @id @db.VarChar(64)
  entityType      String   @map("entity_type") @db.VarChar(32)
  entityId        String   @map("entity_id") @db.VarChar(128)
  locale          String   @default("tr") @db.VarChar(16)
  path            String?  @db.VarChar(512)
  slug            String?  @db.VarChar(255)
  metaTitle       String?  @map("meta_title") @db.VarChar(512)
  metaDescription String?  @map("meta_description") @db.Text
  focusKeyword    String?  @map("focus_keyword") @db.VarChar(255)
  canonicalUrl    String?  @map("canonical_url") @db.VarChar(1024)
  robotsIndex     Boolean  @default(true) @map("robots_index")
  robotsFollow    Boolean  @default(true) @map("robots_follow")
  ogTitle         String?  @map("og_title") @db.VarChar(512)
  ogDescription   String?  @map("og_description") @db.Text
  ogImageUrl      String?  @map("og_image_url") @db.VarChar(1024)
  schemaType      String?  @map("schema_type") @db.VarChar(64)
  schemaJson      Json?    @map("schema_json")
  priority        Float?
  changeFreq      String?  @map("change_freq") @db.VarChar(32)
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")
  updatedBy       String?  @map("updated_by") @db.VarChar(64)
  revision        Int      @default(1)
  extra           Json?

  @@unique([entityType, entityId, locale])
  @@index([path])
  @@map("seo_meta")
}

model UrlHistory {
  id        String    @id @db.VarChar(64)
  fromPath  String    @map("from_path") @db.VarChar(512)
  toPath    String    @map("to_path") @db.VarChar(512)
  code      Int       @default(301)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime? @map("created_at")
  updatedAt DateTime? @map("updated_at")
  extra     Json?

  @@index([fromPath, isActive])
  @@map("url_history")
}

model SeoLegacyLog {
  id        String   @id @default(cuid()) @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  payload   Json

  @@map("seo_legacy_logs")
}

model Language {
  id        String  @id @db.VarChar(64)
  code      String  @unique @db.VarChar(16)
  name      String  @db.VarChar(128)
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  extra     Json?

  @@map("languages")
}

model Currency {
  id        String  @id @db.VarChar(64)
  code      String  @unique @db.VarChar(16)
  name      String  @db.VarChar(128)
  symbol    String? @db.VarChar(16)
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  extra     Json?

  @@map("currencies")
}

model UiString {
  key   String @id @db.VarChar(191)
  value String @db.Text

  @@map("ui_strings")
}

model LegalTerm {
  id      String @id @db.VarChar(64)
  payload Json

  @@map("legal_terms")
}

model PageSection {
  id        String @id @default(cuid()) @db.VarChar(64)
  pageKey   String @map("page_key") @db.VarChar(64)
  sectionKey String @map("section_key") @db.VarChar(64)
  locale    String @default("tr") @db.VarChar(16)
  values    Json

  @@unique([pageKey, sectionKey, locale])
  @@map("page_sections")
}

model FaqItem {
  id       String  @id @db.VarChar(64)
  question String  @db.Text
  answer   String  @db.Text
  isActive Boolean @default(true) @map("is_active")
  sortOrder Int    @default(0) @map("sort_order")
  extra    Json?

  @@map("faq_items")
}

model WhyAdenItem {
  id          String  @id @db.VarChar(64)
  title       String  @db.VarChar(255)
  description String? @db.Text
  icon        String? @db.VarChar(128)
  imageUrl    String? @map("image_url") @db.VarChar(1024)
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")
  extra       Json?

  @@map("why_aden_items")
}

model SliderSlide {
  id                  String  @id @db.VarChar(64)
  imageUrl            String? @map("image_url") @db.VarChar(1024)
  videoUrl            String? @map("video_url") @db.VarChar(1024)
  mediaType           String? @map("media_type") @db.VarChar(32)
  title               String? @db.VarChar(512)
  description         String? @db.Text
  tags                Json?
  isActive            Boolean @default(true) @map("is_active")
  buttonText          String? @map("button_text") @db.VarChar(255)
  buttonUrl           String? @map("button_url") @db.VarChar(1024)
  secondaryButtonText String? @map("secondary_button_text") @db.VarChar(255)
  secondaryButtonUrl  String? @map("secondary_button_url") @db.VarChar(1024)
  badgeText           String? @map("badge_text") @db.VarChar(255)
  overlayOpacity      Float?  @map("overlay_opacity")
  sortOrder           Int     @default(0) @map("sort_order")
  extra               Json?

  @@map("slider_slides")
}

model GalleryCategory {
  id        String  @id @db.VarChar(64)
  name      String  @db.VarChar(255)
  slug      String? @db.VarChar(255)
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")
  extra     Json?
  items     GalleryItem[]

  @@map("gallery_categories")
}

model GalleryItem {
  id         String  @id @db.VarChar(64)
  categoryId String? @map("category_id") @db.VarChar(64)
  imageUrl   String? @map("image_url") @db.VarChar(1024)
  title      String? @db.VarChar(255)
  isActive   Boolean @default(true) @map("is_active")
  sortOrder  Int     @default(0) @map("sort_order")
  extra      Json?
  category   GalleryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@map("gallery_items")
}

model MenuGroup {
  id          String  @id @db.VarChar(64)
  key         String  @unique @db.VarChar(64)
  title       String  @db.VarChar(255)
  type        String? @db.VarChar(64)
  location    String? @db.VarChar(64)
  description String? @db.Text
  status      String? @db.VarChar(32)
  isActive    Boolean @default(true) @map("is_active")
  payload     Json?
  items       MenuItem[]

  @@map("menu_groups")
}

model MenuItem {
  id        String  @id @db.VarChar(64)
  groupId   String  @map("group_id") @db.VarChar(64)
  parentId  String? @map("parent_id") @db.VarChar(64)
  sortOrder Int     @default(0) @map("sort_order")
  payload   Json
  group     MenuGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parent    MenuItem? @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("MenuTree")

  @@index([groupId, sortOrder])
  @@map("menu_items")
}

model FeatureCatalogItem {
  id       String @id @default(cuid()) @db.VarChar(64)
  category String @db.VarChar(64)
  label    String @db.VarChar(255)
  sortOrder Int   @default(0) @map("sort_order")

  @@unique([category, label])
  @@map("feature_catalog_items")
}

model ContentCatalog {
  id      String @id @default("default") @db.VarChar(64)
  payload Json

  @@map("content_catalogs")
}
